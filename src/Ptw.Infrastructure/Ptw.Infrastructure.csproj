<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ptw.Domain\Ptw.Domain.csproj" />
    <ProjectReference Include="..\Ptw.Application\Ptw.Application.csproj" />
  </ItemGroup>

  <!--
    Liberation Sans is embedded so the print renderer has deterministic, licence-clean glyphs on the
    runtime images, which ship without system fonts. Licensed under the SIL Open Font License 1.1.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Printing\Fonts\LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Printing\Fonts\LiberationSans-Bold.ttf" />
    <EmbeddedResource Include="Printing\Assets\logo-regas.png" />
    <EmbeddedResource Include="Printing\Assets\template-ptw-online.pdf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Pkcs is pinned on its own because ASP.NET Core hosts prune the Xml package (it ships in the
         shared framework), which would otherwise leave Microsoft.Data.SqlClient's vulnerable Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
