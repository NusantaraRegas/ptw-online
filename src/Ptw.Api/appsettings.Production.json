{
  "Authentication": {
    "LoginEnabled": true
  },
  "OperationalPolicy": {
    "EnforceMasterAuthorization": false,
    "PolicyVersion": "",
    "AcceptedDecisionReferences": {},
    "PermitActionCodes": {}
  },
  "UserAuthorizationApproval": {
    "AllowAdministratorSelfApproval": false
  },
  "UserAuthorizationRoleProfiles": {
    "Roles": {
      "Administrator": {
        "Label": "Administrator",
        "LocationRequired": false,
        "ActionCodes": ["admin.manage"]
      },
      "Sponsor": {
        "Label": "Sponsor",
        "LocationRequired": false,
        "ActionCodes": [
          "permit.create",
          "permit.update",
          "permit.submit",
          "permit.renewal.request",
          "permit.closure.request",
          "permit.cancel"
        ]
      },
      "HSEValidator": {
        "Label": "PIC HSE",
        "LocationRequired": false,
        "ActionCodes": [
          "permit.validate",
          "permit.validation.revision",
          "permit.validation.reject",
          "permit.validation.escalate",
          "permit.suspend"
        ]
      },
      "AreaOwnerSeniorOfficer": {
        "Label": "SO / Officer Pemilik Wilayah",
        "LocationRequired": true,
        "ActionCodes": ["permit.area-operations.review", "permit.closure.review"]
      },
      "AreaOwnerManager": {
        "Label": "Manager Pemilik Wilayah",
        "LocationRequired": true,
        "ActionCodes": [
          "permit.approve-and-issue",
          "permit.suspend",
          "permit.suspension.resolve",
          "permit.renewal.review",
          "permit.closure.review"
        ]
      },
      "Auditor": {
        "Label": "Auditor",
        "LocationRequired": false,
        "ActionCodes": ["permit.read", "audit.read"]
      }
    }
  },
  "LocationRelease": {
    "AreaOwnerDepartments": {
      "ORF": "Departemen Distribusi Gas dan Pengelolaan ORF",
      "SITE_OFFICE": "Departemen General Affair",
      "WATER_BASED": "Departemen Transport & Operasi FSRU"
    }
  },
  "Attachments": {
    "Enabled": true,
    "MaxFileBytes": 10485760,
    "MaxFilesPerPermit": 20,
    "RequireMalwareScan": false,
    "StoragePath": "/var/lib/ptw/attachments"
  },
  "IssuancePolicy": {
    "Approved": true,
    "RuleVersion": "PTW-FLOW-CHECKLIST-2026-09-24",
    "PrintTemplateVersion": "FM-001-002-003-B-002-NR-B220+SHA256-1C4E6AD366B4",
    "CampaignAssetVersion": "NOT-APPLICABLE-2026-09-24"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 120,
    "LoginPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "GeneratedDocuments": {
    "Enabled": true,
    "StoragePath": "/var/lib/ptw/generated-documents",
    "MaxRenderAttempts": 5
  }
}
