# Production environment for deploy/compose/compose.prod.yaml.
#
# This file is the secret store for the production host (decision 24 September 2026): copy it to
# the deployment directory as `.env`, fill every value, `chmod 600` it, keep it out of Git, and
# include it in the off-host backup set together with the data-protection-keys volume.
# Values are visible to anyone who can run `docker inspect`, so restrict Docker socket access.

# Canonical public host name. nginx redirects every other host to it and the API only accepts it.
PTW_PUBLIC_HOST=ptw.example.com

# Directory on the host holding fullchain.pem and privkey.pem for PTW_PUBLIC_HOST.
# Both files must be readable by uid 101 (the unprivileged nginx user).
PTW_TLS_CERT_DIR=/srv/ptw/tls

# SQL Server Express. `sa` is used only by the one-shot migrate and db-init steps.
# Passwords: SQL complexity policy (length >= 12, three character classes) and no single quote.
PTW_SQL_SA_PASSWORD=
PTW_SQL_APP_PASSWORD=
# Optional: login for the internal backup system (db_backupoperator + db_datareader).
PTW_SQL_BACKUP_PASSWORD=
# Internal interface address the backup host reaches. Never the internet-facing address.
PTW_SQL_BIND_ADDRESS=10.0.0.5
PTW_SQL_PORT=1433

# Portal API that verifies login credentials (POST {BaseUrl}api/v1/User/SecureAuth). https by default.
PTW_PORTAL_API_BASE_URL=https://portal.example.com/
# Set to the literal `true` only for an http:// portal on the internal network, as the accepted risk
# recorded in the OPN-007 amendment (24 September 2026). Login credentials then leave the API
# container in clear text; the api logs a warning at every start while this is on.
PTW_PORTAL_API_ALLOW_INSECURE_HTTP=false

# Largest upload nginx accepts (Attachments:MaxFileBytes is 10 MB plus multipart overhead).
PTW_UPLOAD_MAX_BODY=11m

# Networks allowed to reach /api/v1/admin/ (comma-separated CIDRs). Empty = no network restriction.
PTW_ADMIN_ALLOW_CIDRS=

# Fixed subnet of the compose `frontend` network. The API trusts X-Forwarded-* only from it.
PTW_FRONTEND_SUBNET=172.28.0.0/24

# Host ports nginx is published on. Keep the defaults in production.
PTW_HTTP_PORT=80
PTW_HTTPS_PORT=443
