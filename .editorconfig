root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[src/Ptw.Infrastructure/Persistence/Migrations/*.cs]
# EF Core generates constant index-column arrays. They are migration metadata,
# not a repeated application hot path.
dotnet_diagnostic.CA1861.severity = none

[*.{ts,html,scss,json,yaml,yml}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
