# Development only. Do not reuse this value outside a local machine.
PTW_SQL_BOOTSTRAP_PASSWORD=Change_this_dev_only_123!
PTW_HTTP_PORT=8080
PTW_SQL_PORT=1433
PTW_UPLOAD_MAX_BODY=11m
# Portal API service login obtains a bearer token from SecureAuth; PTW then verifies the employee
# credential through bearer-protected ADAuth. The host is mapped to the Docker host gateway.
PTW_PORTAL_API_BASE_URL=http://local.api.portal.com/
PTW_PORTAL_API_HOST=local.api.portal.com
PTW_PORTAL_API_SERVICE_USERNAME=admin
PTW_PORTAL_API_SERVICE_PASSWORD=replace_with_portal_service_password
# Hot reload stack (compose.hotreload.yaml) only.
PTW_API_PORT=5080
PTW_WEB_POLL_MS=1000
PTW_DOTNET_POLLING=true
