# Development only. Do not reuse this value outside a local machine.
PTW_SQL_BOOTSTRAP_PASSWORD=Change_this_dev_only_123!
PTW_HTTP_PORT=8080
PTW_SQL_PORT=1433
PTW_UPLOAD_MAX_BODY=11m
# Portal API that verifies login credentials (POST {BaseUrl}api/v1/User/SecureAuth). The host name is
# also mapped to the Docker host gateway so the local IIS site is reachable from the api container.
PTW_PORTAL_API_BASE_URL=http://local.api.portal.com/
PTW_PORTAL_API_HOST=local.api.portal.com
# Hot reload stack (compose.hotreload.yaml) only.
PTW_API_PORT=5080
PTW_WEB_POLL_MS=1000
PTW_DOTNET_POLLING=true
